{
  // For the editor and `npm run typecheck`: source *and* tests, with the test
  // runner's globals named explicitly (TypeScript 6 no longer loads every
  // @types package by default). The build uses tsconfig.build.json.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "noEmit": true,
    "types": ["node", "jest"]
  },
  "include": ["src/**/*.ts"]
}
