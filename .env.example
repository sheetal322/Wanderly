# Copy to .env for running services on the host (`npm run dev:api`).
# Inside Docker Compose these are set in docker-compose.yml instead.
NODE_ENV=development
LOG_LEVEL=debug

API_PORT=3000

DATABASE_URL=postgres://wanderly:wanderly@localhost:5432/wanderly
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@wanderly.dev
