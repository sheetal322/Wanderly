{
  "name": "wanderly",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run db:generate && tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "npm run db:generate && tsc --build --pretty && npm run typecheck:tests",
    "typecheck:tests": "tsc --noEmit --pretty -p libs/config && tsc --noEmit --pretty -p libs/db && tsc --noEmit --pretty -p libs/recurrence && tsc --noEmit --pretty -p apps/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "dev:api": "npm run start:dev --workspace @wanderly/api",
    "db:generate": "prisma generate --schema libs/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema libs/db/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema libs/db/prisma/schema.prisma",
    "keys:generate": "node scripts/generate-jwt-keys.mjs",
    "infra:up": "docker compose up -d postgres redis kafka kafka-ui mailpit",
    "infra:down": "docker compose down",
    "up": "docker compose up --build"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.8.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "prisma": "6.19.3",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0"
  }
}
